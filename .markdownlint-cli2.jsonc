// markdownlint-cli2 config - a szabalykonyv (md/) stilusahoz igazitva.
// A kikapcsolt szabalyok a projekt tudatos formazasat tukrozik (ekezetes,
// tabla-nehez, <br>-t hasznalo RPG szabalyszoveg), nem hibak.
{
  "config": {
    "MD013": false, // sorhossz: a tablak es hivatkozasok tulnyulnak 80 karakteren
    "MD033": false, // inline HTML: <br> szandekosan hasznalt a szabalyszovegben
    "MD040": false, // fenced code nyelv: a pelda-blokkok nyelv nelkuliek
    "MD041": false, // elso sor heading: nem minden md-fajl kezdodik H1-gyel
    "MD024": false, // ismetlodo headingek: szandekosak (azonos alcimek fejezetekben)
    "MD060": false, // tabla-formazas: a kezi tablak nem egyseges stilusuak
    "MD001": false, // heading-szint ugras: a #### Kovetelmeny/Hatas tudatos vizualis tagolas a ## blokkokban
    "MD036": false, // kiemeles heading helyett: **cimke**-szeru vizualis jelolok (nem akarunk ranuk anchort/TOC-ot)
    "MD045": false, // kep alt-szoveg: a szabalykonyv kepei tabla-/dekorativ beagyazasok
    "MD025": false, // tobb H1 egy dokumentumban: megengedett (pl. szilank.md tagolasa)
    "MD051": false  // link-fragment: a cli2 az emoji-s GitHub-anchorokat hamisan torottnek jelzi, elesben mukodnek (linkspector is zold)
  },
  "globs": ["md/**/*.md", "README.md"]
}
