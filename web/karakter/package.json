{
  "name": "szilank-karakteralkoto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "python3 ../../data/generate_tables.py",
    "prebuild": "python3 ../../data/generate_tables.py",
    "test": "vitest run",
    "test:changed": "vitest run --changed HEAD~1",
    "build": "vitest run && tsc --noEmit && vite build",
    "build:fast": "tsc --noEmit && vite build",
    "build:changed": "vitest run --changed HEAD~1 && tsc --noEmit && vite build",
    "postbuild": "mkdir -p dist/data/tables dist/data/karakter && cp ../../data/tables/*.json dist/data/tables/ && cp ../../data/rules.json dist/data/ && cp ../../data/karakter/*.json dist/data/karakter/",
    "preview": "vite preview"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fast-check": "^3.22.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^2.1.8"
  }
}
